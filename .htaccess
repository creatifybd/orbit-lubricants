<IfModule mod_headers.c>
  <FilesMatch "\.(html|jsx)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(webp|png|jpe?g|svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .jsx
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^src/main\.jsx$ legacy-entry.js [L]
  # Deny public access to repository internals, source and potentially private archives.
  # Preserve the historical compiled entrypoint and all public product images.
  RewriteRule ^(?:\\.git|\\.github|\\.builds|\\.env|src|scripts|hosting|deployment|docs|node_modules)(?:/|$) - [F,L,NC]
  RewriteRule ^(?:package(?:-lock)?\\.json|vite\\.config\\.js|deploy\\.ps1|index\\.source\\.html|.*\\.(?:zip|sql|bak|tar|tgz))$ - [F,L,NC]
  RewriteRule ^images/(.*)$ public/images/$1 [L]
  RewriteRule ^products/(.*)$ public/products/$1 [L]
  RewriteRule ^logo\.png$ public/logo.png [L]
  RewriteRule ^logo-dark-bg\.png$ public/logo-dark-bg.png [L]
</IfModule>
