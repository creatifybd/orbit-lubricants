<IfModule mod_headers.c>
  <FilesMatch "\.(html|jsx)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(webp|png|jpe?g|svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .jsx
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Canonicalise ONLY Orbit's www hostname; other Hostinger domains are untouched.
  RewriteCond %{HTTP_HOST} ^www\.orbit-lubricants\.com$ [NC]
  RewriteRule ^ https://orbit-lubricants.com%{REQUEST_URI} [R=301,L,NE]

  # Protect private source directories that must never be hosted in public_html.
  # A future release should publish compiled dist CONTENTS only.
  RewriteRule ^(?:\.git|\.github|\.builds|\.env|src|scripts|hosting|deployment|docs|node_modules)(?:/|$) - [F,L,NC]
  RewriteRule ^(?:package(?:-lock)?\.json|vite\.config\.js|deploy\.ps1|index\.source\.html|.*\.(?:zip|sql|bak|tar|tgz))$ - [F,L,NC]
  RewriteRule ^src/main\.jsx$ legacy-entry.js [L]

  # Already-published static paths (including /products/:slug/index.html)
  # must take precedence over legacy public/* fallbacks.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^images/(.*)$ public/images/$1 [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^products/(.*)$ public/products/$1 [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^logo\.png$ public/logo.png [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^logo-dark-bg\.png$ public/logo-dark-bg.png [L]
</IfModule>

# Conservative browser security headers (avoid restrictive CSP until third-party audit).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <Files "legacy-entry.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>
